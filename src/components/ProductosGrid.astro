---
import productos from '../data/productos.json';
const categorias = ['Todos', ...new Set(productos.map((p) => p.categoria))];
---
<section id="productos" class="scroll-mt-24 bg-white px-6 py-24 lg:px-10"><div class="mx-auto max-w-7xl"><div class="flex flex-col justify-between gap-6 md:flex-row md:items-end"><div><p class="eyebrow">Lo que hacemos mejor</p><h2 class="section-title">Servicios digitales</h2></div><div id="filters" class="flex flex-wrap gap-2">{categorias.map((categoria, i) => <button class:list={['filter-btn', { active: i === 0 }]} data-filter={categoria}>{categoria}</button>)}</div></div><div id="product-grid" class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{productos.map((producto) => <article class="product-card group overflow-hidden rounded-2xl border border-ink/10 bg-sand" data-category={producto.categoria}><img class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" src={producto.imagen} alt={producto.titulo} loading="lazy" /><div class="p-6"><p class="text-sm font-semibold text-lime-700">{producto.categoria}</p><h3 class="mt-2 text-2xl font-bold text-ink">{producto.titulo}</h3><p class="mt-3 leading-7 text-ink/60">{producto.descripcion}</p></div></article>)}</div></div></section>
<script>document.querySelectorAll('.filter-btn').forEach((button) => button.addEventListener('click', () => { const filter = button.dataset.filter; document.querySelectorAll('.filter-btn').forEach((b) => b.classList.toggle('active', b === button)); document.querySelectorAll('.product-card').forEach((card) => { card.classList.toggle('hidden', filter !== 'Todos' && card.dataset.category !== filter); }); }));</script>
