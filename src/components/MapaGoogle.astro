---
import locales from '../data/locales.json';
const GOOGLE_MAPS_API_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
---
<section id="puntos-de-venta" class="scroll-mt-24 bg-sand px-6 py-24 lg:px-10"><div class="mx-auto max-w-7xl"><p class="eyebrow">Encontranos cerca</p><h2 class="section-title">Puntos de venta</h2><p class="mt-5 max-w-xl text-lg leading-8 text-ink/60">Visitá nuestros espacios en La Plata y descubrí tu próximo favorito.</p><div id="map" class="mt-10 h-[28rem] overflow-hidden rounded-3xl bg-ink/10 shadow-inner" aria-label="Mapa de puntos de venta"></div></div></section>
<script define:vars={{ locales, GOOGLE_MAPS_API_KEY }}>
  function initMap() { const center = { lat: -34.9214, lng: -57.9544 }; const map = new google.maps.Map(document.getElementById('map'), { zoom: 14, center, mapId: 'DEMO_MAP_ID' }); locales.forEach((local) => { const marker = new google.maps.Marker({ position: { lat: local.lat, lng: local.lng }, map, title: local.nombre }); const info = new google.maps.InfoWindow({ content: `<strong>${local.nombre}</strong><br>${local.direccion}` }); marker.addListener('click', () => info.open({ anchor: marker, map })); }); }
  if (GOOGLE_MAPS_API_KEY) { const script = document.createElement('script'); script.src = `https://maps.googleapis.com/maps/api/js?key=${GOOGLE_MAPS_API_KEY}&callback=initMap`; script.async = true; window.initMap = initMap; document.head.appendChild(script); } else { document.getElementById('map').innerHTML = '<div class="flex h-full items-center justify-center p-8 text-center text-ink/60">Configurá PUBLIC_GOOGLE_MAPS_API_KEY en tu archivo .env para activar el mapa.</div>'; }
</script>
