<header class="fixed inset-x-0 top-0 z-50 border-b border-black/5 bg-sand/90 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10" aria-label="Navegación principal">
    <a href="/" class="text-xl font-black tracking-tight text-ink">NEXO<span class="text-lime-600">.</span></a>
    <button id="menu-toggle" class="rounded-lg p-2 text-ink md:hidden" aria-label="Abrir menú" aria-expanded="false"><span class="text-2xl">☰</span></button>
    <div id="menu" class="absolute left-0 top-full hidden w-full border-b bg-sand px-6 py-5 md:static md:flex md:w-auto md:items-center md:gap-8 md:border-0 md:bg-transparent md:p-0">
      <a class="nav-link" href="/#inicio">Inicio</a><a class="nav-link" href="/#productos">Servicios</a><a class="nav-link" href="/puntos-de-venta">Puntos de venta</a><a class="nav-link" href="/contacto">Contacto</a>
    </div>
  </nav>
</header>
<script>
  const toggle = document.querySelector('#menu-toggle'); const menu = document.querySelector('#menu');
  toggle?.addEventListener('click', () => { const open = !menu?.classList.toggle('hidden'); toggle.setAttribute('aria-expanded', String(open)); });
  document.querySelectorAll('.nav-link').forEach((link) => link.addEventListener('click', () => menu?.classList.add('hidden')));
</script>
