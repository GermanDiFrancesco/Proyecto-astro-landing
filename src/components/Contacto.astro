---
const whatsapp = import.meta.env.LOCAL_WHATSAPP_NUMBER;
const formEndpoint = import.meta.env.LOCAL_FORMSPREE_ENDPOINT || '#';
---
<section id="contacto" class="scroll-mt-24 px-6 py-24 lg:px-10"><div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-2"><div><p class="eyebrow">Hablemos</p><h2 class="section-title">¿Tenés una idea?<br />Hagámosla realidad.</h2><p class="mt-6 max-w-md text-lg leading-8 text-ink/60">Escribinos y te respondemos a la brevedad.</p><a class="btn-primary mt-8 inline-flex" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noreferrer">Escribir por WhatsApp ↗</a></div><form class="space-y-5" action={formEndpoint} method="POST"><div><label class="form-label" for="nombre">Nombre</label><input class="form-input" id="nombre" name="nombre" required /></div><div><label class="form-label" for="email">Email</label><input class="form-input" id="email" name="email" type="email" required /></div><div><label class="form-label" for="mensaje">Mensaje</label><textarea class="form-input min-h-36" id="mensaje" name="mensaje" required></textarea></div><button class="btn-primary w-full sm:w-auto" type="submit">Enviar mensaje</button></form></div></section>
