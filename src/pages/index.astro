---
import Header from '../components/Header.astro'; import Hero from '../components/Hero.astro'; import ProductosGrid from '../components/ProductosGrid.astro'; import Newsletter from '../components/Newsletter.astro'; import Contacto from '../components/Contacto.astro'; import Footer from '../components/Footer.astro'; import '../styles/global.css';
---
<!doctype html><html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Nexo: soluciones informáticas para negocios que quieren crecer." /><title>Nexo — Soluciones digitales</title></head><body class="bg-sand font-sans text-ink antialiased"><Header /><main><Hero /><ProductosGrid /><Newsletter /><section class="px-6 py-16 text-center"><a class="btn-secondary" href="/puntos-de-venta">Conocé nuestros Puntos de venta →</a></section><Contacto /></main><Footer /></body></html>
<style is:global>
  html { scroll-behavior: smooth; } .nav-link { color: rgb(23 33 38 / .65); font-size: .9rem; font-weight: 600; } .nav-link:hover { color: #172126; } .btn-primary { border-radius: .75rem; background: #172126; color: white; padding: .85rem 1.2rem; font-weight: 700; transition: all .2s; } .btn-primary:hover { background: #33434a; transform: translateY(-1px); } .btn-secondary { border-radius: .75rem; border: 1px solid rgb(23 33 38 / .2); padding: .85rem 1.2rem; font-weight: 700; } .btn-secondary:hover { background: white; } .eyebrow { color: #5e8b0c; font-size: .75rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; } .section-title { margin-top: .5rem; font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 900; letter-spacing: -.05em; line-height: 1; } .filter-btn { border-radius: 999px; border: 1px solid rgb(23 33 38 / .15); padding: .55rem 1rem; font-size: .875rem; font-weight: 700; } .filter-btn.active, .filter-btn:hover { border-color: #172126; background: #172126; color: white; } .form-label { display: block; margin-bottom: .5rem; font-size: .875rem; font-weight: 700; } .form-input { width: 100%; border-radius: .75rem; border: 1px solid rgb(23 33 38 / .15); background: white; padding: .85rem 1rem; outline: none; } .form-input:focus { border-color: #172126; box-shadow: 0 0 0 3px rgb(199 243 107 / .7); }
</style>
